<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="007b-fitness-programs-add-en-columns" author="ivo">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="fitness_programs" columnName="name_en"/>
            </not>
        </preConditions>
        <addColumn tableName="fitness_programs">
            <column name="name_en" type="VARCHAR(100)"/>
            <column name="description_en" type="VARCHAR(1000)"/>
            <column name="benefits_en" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>


    <changeSet id="007b-exercises-add-en-columns" author="ivo">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="exercises" columnName="name_en"/>
            </not>
        </preConditions>
        <addColumn tableName="exercises">
            <column name="name_en" type="VARCHAR(100)"/>
            <column name="description_en" type="VARCHAR(500)"/>
            <column name="muscle_group_en" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>


    <changeSet id="007b-fitness-en-data" author="ivo">
        <update tableName="fitness_programs">
            <column name="name_en" value="Push/Pull/Legs"/>
            <column name="description_en" value="Push/Pull/Legs splits workouts into three days: Push (pushing movements - chest, shoulders, triceps), Pull (pulling movements - back, biceps), and Legs (legs and core). One of the most popular splits for building muscle."/>
            <column name="benefits_en" value="Improves muscle mass, allows intense work on each muscle group, gives recovery time between workouts."/>
            <where>name='Push/Pull/Legs'</where>
        </update>
        <update tableName="fitness_programs">
            <column name="name_en" value="Upper/Lower Split"/>
            <column name="description_en" value="Upper/Lower Split divides workouts into upper and lower body. This allows you to train each part twice per week with good recovery."/>
            <column name="benefits_en" value="Improves strength and muscle mass, allows more frequent training of each part, suitable for beginners and advanced."/>
            <where>name='Upper/Lower Split'</where>
        </update>
        <update tableName="fitness_programs">
            <column name="name_en" value="Full Body"/>
            <column name="description_en" value="Full Body workouts include exercises for the whole body in each session. Suitable for beginners or those with limited time."/>
            <column name="benefits_en" value="Improves overall strength, effective for beginners, allows more frequent training of muscle groups."/>
            <where>name='Full Body'</where>
        </update>
        <update tableName="fitness_programs">
            <column name="name_en" value="Bro Split"/>
            <column name="description_en" value="Bro Split divides workouts by muscle groups - one day per group (chest, back, shoulders, arms, legs). Allows maximum focus on each group."/>
            <column name="benefits_en" value="Maximum focus on each muscle group, suitable for advanced, allows intense workouts."/>
            <where>name='Bro Split'</where>
        </update>
        <update tableName="fitness_programs">
            <column name="name_en" value="5-Day Split"/>
            <column name="description_en" value="5-Day Split divides workouts into 5 days: Monday - Chest, Tuesday - Back, Wednesday - Shoulders, Thursday - Arms, Friday - Legs. Suitable for advanced trainees."/>
            <column name="benefits_en" value="Maximum specialization per muscle group, suitable for advanced, allows intense workouts with good recovery."/>
            <where>name='5-Day Split'</where>
        </update>
    </changeSet>


