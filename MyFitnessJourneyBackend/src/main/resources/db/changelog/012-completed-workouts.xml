<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="012-create-completed-workouts-table" author="ivo">
        <createTable tableName="completed_workouts">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_completed_workout_user" references="users(id)"/>
            </column>
            <column name="fitness_program_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_completed_workout_program" references="fitness_programs(id)"/>
            </column>
            <column name="day_of_week" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="week_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_completed_workouts_user_week" tableName="completed_workouts">
            <column name="user_id"/>
            <column name="fitness_program_id"/>
            <column name="week_start_date"/>
        </createIndex>
        <addUniqueConstraint tableName="completed_workouts"
                            columnNames="user_id, fitness_program_id, day_of_week, week_start_date"
                            constraintName="uk_completed_workout_user_program_day_week"/>
    </changeSet>

</databaseChangeLog>
