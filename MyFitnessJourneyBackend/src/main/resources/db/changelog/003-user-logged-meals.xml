<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="011-create-user-logged-meals-table" author="ivo">
        <createTable tableName="user_logged_meals">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_logged_meal_user" references="users(id)"/>
            </column>
            <column name="meal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_logged_meal_meal" references="meals(id)"/>
            </column>
            <column name="logged_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_user_logged_date" tableName="user_logged_meals">
            <column name="user_id"/>
            <column name="logged_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

