<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="010-create-meal-translations-table" author="ivo">
        <createTable tableName="meal_translations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="meal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meal_translation_meal" references="meals(id)"/>
            </column>
            <column name="locale" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>
        <addUniqueConstraint tableName="meal_translations" columnNames="meal_id, locale" constraintName="uq_meal_translation_locale"/>
    </changeSet>
    <changeSet id="010-migrate-meals-to-translations-bg" author="ivo">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="meals" columnName="name"/>
        </preConditions>
        <sql>INSERT INTO meal_translations (meal_id, locale, name, description) SELECT id, 'bg', name, description FROM meals</sql>
    </changeSet>
    <changeSet id="010-migrate-meals-to-translations-en" author="ivo">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="meals" columnName="name_en"/>
        </preConditions>
        <sql>INSERT INTO meal_translations (meal_id, locale, name, description)
            SELECT id, 'en', COALESCE(name_en, name), COALESCE(description_en, description) FROM meals</sql>
    </changeSet>
    <changeSet id="010-drop-meal-translation-columns" author="ivo">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="meals" columnName="name"/>
        </preConditions>
        <dropColumn tableName="meals" columnName="name"/>
        <dropColumn tableName="meals" columnName="name_en"/>
        <dropColumn tableName="meals" columnName="description"/>
        <dropColumn tableName="meals" columnName="description_en"/>
    </changeSet>
</databaseChangeLog>
