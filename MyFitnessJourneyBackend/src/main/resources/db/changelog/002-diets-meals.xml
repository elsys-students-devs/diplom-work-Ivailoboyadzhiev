<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="002-create-diets-table" author="ivo">
        <createTable tableName="diets">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="benefits" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-meals-table" author="ivo">
        <createTable tableName="meals">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="calories" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="protein" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="carbs" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="fiber" type="DOUBLE PRECISION">
                <constraints nullable="true"/>
            </column>
            <column name="sugar" type="DOUBLE PRECISION">
                <constraints nullable="true"/>
            </column>
            <column name="diet_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meal_diet" references="diets(id)"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Load Diets from CSV -->
    <changeSet id="004-load-diets" author="ivo">
        <loadData
            file="db/data/diets.csv"
            tableName="diets"
            separator=","
            encoding="UTF-8"/>
    </changeSet>

    <!-- Load Meals from CSV -->
    <changeSet id="005-load-meals" author="ivo">
        <loadData
            file="db/data/meals.csv"
            tableName="meals"
            separator=","
            encoding="UTF-8"/>
    </changeSet>

</databaseChangeLog>

